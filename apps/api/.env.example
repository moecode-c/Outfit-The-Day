MONGODB_URI="mongodb://localhost:27017/otd"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Dev placeholders. Production needs two different random values: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# Uploads go to UPLOAD_DIR unless R2 is configured (set all four R2_* or none).
UPLOAD_DIR="./uploads"
# R2_BUCKET="otd"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_ENDPOINT=""            # optional, any S3-compatible endpoint
# ALLOW_DISK_UPLOADS=true   # production only, and only on a persistent disk

# Backups (pnpm --filter api backup)
# BACKUP_DIR="./backups"
# BACKUP_KEEP=14

# Email (optional). Without a provider, emails (including password reset links) are only stored
# in the admin outbox.
# Brevo (preferred): an API key from Brevo → SMTP & API → API keys, and a sender address
# verified in Brevo → Senders, domains & dedicated IPs.
# BREVO_API_KEY="xkeysib-..."
# MAIL_FROM="OTD <no-reply@your-domain>"
# Or any SMTP server (used only when BREVO_API_KEY is not set):
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="OTD <no-reply@example.com>"
