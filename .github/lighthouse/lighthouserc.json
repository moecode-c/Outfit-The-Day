{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/en",
        "http://localhost:3000/ar",
        "http://localhost:3000/en/women",
        "http://localhost:3000/en/brands",
        "http://localhost:3000/en/search?q=dress"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "optimistic" }],
        "categories:performance": ["warn", { "minScore": 0.7, "aggregationMethod": "optimistic" }],
        "categories:best-practices": ["warn", { "minScore": 0.9, "aggregationMethod": "optimistic" }],
        "categories:seo": ["warn", { "minScore": 0.9, "aggregationMethod": "optimistic" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
